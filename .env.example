# Copie este arquivo para .env.dev / .env.test / .env.prod e preencha os valores.
# NUNCA commite os arquivos .env.* reais.

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Gere uma chave segura: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars

DATABASE_URL=sqlite:///instance/eponto_dev.db
RATELIMIT_STORAGE_URI=memory://

# E-mail (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=('Nome', 'seu-email@gmail.com')
