# Exemplo de ambiente de PRODUÇÃO. O make_env.py copia este arquivo para
# .env.prod (ignorado pelo Git). TROQUE os segredos antes de usar de verdade.

FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0

# Gere uma chave segura: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars

DATABASE_URL=sqlite:///instance/eponto_prod.db
RATELIMIT_STORAGE_URI=memory://

# E-mail (opcional) — preencha com credenciais reais em produção.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=('Nome', 'seu-email@gmail.com')
