# Exemplo de ambiente de TESTE. O make_env.py copia este arquivo para
# .env.test (que é ignorado pelo Git). Valores de teste não são segredos.

FLASK_APP=app.py
FLASK_ENV=testing
FLASK_DEBUG=0
SECRET_KEY=test-secret-key
TESTING=1
WTF_CSRF_ENABLED=0
DATABASE_URL=sqlite:///eponto_test.db
RATELIMIT_STORAGE_URI=memory://
